<Window x:Class="ARMpulse.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:charts="clr-namespace:ARMpulse.Windows.Controls"
        Title="ARMpulse" Icon="Assets/ARMpulse.ico" Width="1280" Height="860" MinWidth="1000" MinHeight="680" WindowStartupLocation="CenterScreen" Topmost="{Binding AlwaysOnTop}">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="202"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#14181B" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
      <Grid Margin="16,26,16,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="9,0,0,5">
            <Border Width="29" Height="29" Background="#7BE2B0" CornerRadius="8" Margin="0,0,10,0"><TextBlock Text="ϟ" FontSize="25" Foreground="#12251D" HorizontalAlignment="Center" Margin="0,-4,0,0"/></Border>
            <TextBlock Text="ARMpulse" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="A little more clarity." Style="{StaticResource Muted}" FontSize="11" Margin="10,7,0,34"/>
          <TextBlock Text="WORKSPACE" Style="{StaticResource Label}" Margin="14,0,0,8"/>
          <ListBox SelectedIndex="{Binding PageIndex}" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}" AutomationProperties.Name="Navigation">
            <ListBoxItem AutomationProperties.Name="Overview"><TextBlock Text="◈   Overview" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/></ListBoxItem>
            <ListBoxItem AutomationProperties.Name="Processes"><TextBlock Text="☷   Processes" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/></ListBoxItem>
            <ListBoxItem AutomationProperties.Name="Memory"><TextBlock Text="▤   Memory" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/></ListBoxItem>
            <ListBoxItem AutomationProperties.Name="History"><TextBlock Text="↗   History" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/></ListBoxItem>
            <ListBoxItem AutomationProperties.Name="Settings"><TextBlock Text="⚙   Settings &amp; about" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/></ListBoxItem>
          </ListBox>
        </StackPanel>
        <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="9,18,0,0">
          <StackPanel><TextBlock Text="WINDOWS ON ARM" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="{Binding Machine}" Margin="0,7,0,4" TextTrimming="CharacterEllipsis"/><TextBlock Text="Native. Local. Yours." Style="{StaticResource Muted}" FontSize="11"/></StackPanel>
        </Border>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="30,26,30,14">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,24">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="{Binding PageTitle}" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource Muted}" Margin="0,8,20,0"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,0,0">
          <Border Background="#20382E" CornerRadius="5" Padding="9,7" Margin="0,0,12,0" VerticalAlignment="Center"><TextBlock Text="{Binding LiveText}" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold"/></Border>
          <Button Content="{Binding PauseText}" Click="Pause_Click" ToolTip="Pause or resume monitoring (Ctrl+Space)"/>
        </StackPanel>
      </Grid>

      <!-- OVERVIEW -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding PageIndex, Converter={StaticResource PageVisibility}, ConverterParameter=0}">
        <StackPanel Margin="0,0,8,0">
          <UniformGrid Columns="4" Margin="0,0,-12,20">
            <Border Style="{StaticResource Panel}" Margin="0,0,12,0" ToolTip="Calculated from GetSystemTimes. Total CPU capacity = 100%."><StackPanel><TextBlock Text="CPU" Style="{StaticResource Label}"/><TextBlock Text="{Binding Cpu}" Style="{StaticResource Metric}" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="{Binding Processor}" Style="{StaticResource Muted}" FontSize="11"/></StackPanel></Border>
            <Border Style="{StaticResource Panel}" Margin="0,0,12,0" ToolTip="Physical memory in use, reported by GlobalMemoryStatusEx."><StackPanel><TextBlock Text="MEMORY" Style="{StaticResource Label}"/><TextBlock Text="{Binding Memory}" Style="{StaticResource Metric}" Foreground="#B8A5FA"/><TextBlock Text="{Binding MemoryDetail}" Style="{StaticResource Muted}" FontSize="11"/></StackPanel></Border>
            <Border Style="{StaticResource Panel}" Margin="0,0,12,0" ToolTip="Received bytes per second across active adapters, excluding loopback and tunnel adapters. Virtual adapters may count traffic twice."><StackPanel><TextBlock Text="NETWORK  ↓" Style="{StaticResource Label}"/><TextBlock Text="{Binding Download}" FontSize="23" FontWeight="SemiBold" Margin="0,4,0,8" Foreground="#80BEF4"/><TextBlock Style="{StaticResource Muted}" FontSize="11"><Run Text="↑ "/><Run Text="{Binding Upload}"/></TextBlock></StackPanel></Border>
            <Border Style="{StaticResource Panel}" Margin="0,0,12,0" ToolTip="Reported by Windows GetSystemPowerStatus."><StackPanel><TextBlock Text="BATTERY" Style="{StaticResource Label}"/><TextBlock Text="{Binding Battery}" Style="{StaticResource Metric}"/><TextBlock Text="{Binding Power}" Style="{StaticResource Muted}" FontSize="11"/></StackPanel></Border>
          </UniformGrid>
          <Border Style="{StaticResource Panel}" Margin="0,0,0,20">
            <StackPanel>
              <Grid><TextBlock Text="The rhythm of your system" Style="{StaticResource SectionTitle}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="●  CPU" Foreground="{StaticResource AccentBrush}" Margin="0,2,20,0"/><TextBlock Text="●  Memory" Foreground="#B8A5FA" Margin="0,2,0,0"/></StackPanel></Grid>
              <TextBlock Text="{Binding HistoryRange}" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,16"/>
              <Grid><charts:HistoryChart Values="{Binding CpuHistory}" SecondaryValues="{Binding MemoryHistory}" Stroke="{StaticResource AccentBrush}" Height="175" Margin="0,0,31,0" AutomationProperties.Name="CPU and memory history, 0 to 100 percent"/><TextBlock Text="100%" Style="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Right"/><TextBlock Text="0%" Style="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid>
            </StackPanel>
          </Border>
          <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Panel}" Margin="0,0,16,0">
              <StackPanel>
                <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="View all  →" Click="ViewProcesses_Click" Padding="10,5"/><TextBlock Text="Busiest right now" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/></DockPanel>
                <ItemsControl ItemsSource="{Binding TopProcesses}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Architecture}" Style="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding MemoryText}" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding CpuText}" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              </StackPanel>
            </Border>
            <StackPanel Grid.Column="1">
              <Border Style="{StaticResource Panel}" BorderBrush="#355447" Margin="0,0,0,16"><StackPanel><TextBlock Text="A LITTLE INSIGHT" Style="{StaticResource Label}" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="{Binding InsightTitle}" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding InsightBody}" Style="{StaticResource Muted}" LineHeight="21"/><Button Content="Explore processes  →" Click="ViewProcesses_Click" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Accelerators" Style="{StaticResource SectionTitle}"/><TextBlock Text="GPU / NPU  —  unavailable" Style="{StaticResource Muted}"/><TextBlock Text="This collector does not read Adreno GPU or Hexagon NPU utilization. No guessed values." Style="{StaticResource Muted}" FontSize="11" LineHeight="18" Margin="0,8,0,0"/></StackPanel></Border>
            </StackPanel>
          </Grid>
        </StackPanel>
      </ScrollViewer>

      <!-- PROCESSES -->
      <Grid Grid.Row="1" Visibility="{Binding PageIndex, Converter={StaticResource PageVisibility}, ConverterParameter=1}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search process name, PID, or executable path (Ctrl+F)" AutomationProperties.Name="Search processes" Margin="0,0,12,0"/><ComboBox Grid.Column="1" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" AutomationProperties.Name="Process filter" Margin="0,0,12,0"/><Button Grid.Column="2" Content="Export CSV" Click="Export_Click" ToolTip="Export the currently filtered process list"/></Grid>
        <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="0" ClipToBounds="True">
          <Grid><DataGrid x:Name="ProcessGrid" ItemsSource="{Binding Processes}" SelectedItem="{Binding Selected}" Sorting="ProcessGrid_Sorting" AutomationProperties.Name="Running processes">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Process" Binding="{Binding Name}" SortMemberPath="Name" Width="*" MinWidth="140"/>
              <DataGridTextColumn Header="PID" Binding="{Binding Pid}" SortMemberPath="Pid" Width="65"/>
              <DataGridTextColumn Header="CPU" Binding="{Binding CpuText}" SortMemberPath="Cpu" Width="80"/>
              <DataGridTextColumn Header="Memory" Binding="{Binding MemoryText}" SortMemberPath="Memory" Width="100"/>
              <DataGridTextColumn Header="I/O /s" Binding="{Binding IoText}" SortMemberPath="IoBytesPerSecond" Width="100"/>
              <DataGridTextColumn Header="Architecture" Binding="{Binding Architecture}" Width="120"/>
              <DataGridTextColumn Header="Access" Binding="{Binding Status}" Width="85"/>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Text="No processes match this search." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Processes.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
          </Grid>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0,16,0,0" Padding="18,14">
          <StackPanel>
            <DockPanel Margin="0,0,0,10"><TextBlock DockPanel.Dock="Right" Text="{Binding FilterCount}" Style="{StaticResource Muted}" FontSize="11"/><TextBlock Text="Selected process" FontWeight="SemiBold"/></DockPanel>
            <TextBlock Text="{Binding Selected.Name, TargetNullValue='Select a process to inspect it'}" FontSize="17" Margin="0,0,0,5"/>
            <TextBlock Text="{Binding Selected.Path, TargetNullValue='Executable path unavailable or no selection'}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Selected.Path}" FontSize="11" Margin="0,0,0,12"/>
            <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,12"><Run Text="CPU  "/><Run Text="{Binding Selected.CpuText, TargetNullValue='—'}"/><Run Text="     Memory  "/><Run Text="{Binding Selected.MemoryText, TargetNullValue='—'}"/><Run Text="     I/O  "/><Run Text="{Binding Selected.IoText, TargetNullValue='—'}"/><Run Text="     Threads  "/><Run Text="{Binding Selected.Threads, TargetNullValue='—'}"/></TextBlock>
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Open folder" Click="OpenFolder_Click" IsEnabled="{Binding HasSelection}" Margin="0,0,8,0"/><Button Content="Lower priority" Click="LowerPriority_Click" IsEnabled="{Binding HasSelection}" Margin="0,0,8,0" ToolTip="Set Below Normal CPU scheduling priority. This is not Windows Efficiency Mode."/><Button Content="End process…" Click="EndProcess_Click" Foreground="#FFAAA7" BorderBrush="#72423F" IsEnabled="{Binding HasSelection}"/></StackPanel>
              <TextBlock Text="{Binding Selected.Architecture}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
            </DockPanel>
          </StackPanel>
        </Border>
      </Grid>

      <!-- MEMORY -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding PageIndex, Converter={StaticResource PageVisibility}, ConverterParameter=2}">
        <StackPanel Margin="0,0,8,0">
          <Border Style="{StaticResource Panel}" Margin="0,0,0,20"><StackPanel><TextBlock Text="PHYSICAL MEMORY IN USE" Style="{StaticResource Label}"/><DockPanel><TextBlock Text="{Binding MemoryPercent}" DockPanel.Dock="Right" FontSize="32" Foreground="#B8A5FA"/><TextBlock Text="{Binding Memory}" FontSize="48" FontWeight="SemiBold"/></DockPanel><TextBlock Text="{Binding MemoryDetail}" Style="{StaticResource Muted}" Margin="0,8,0,20"/><ProgressBar Value="{Binding MemoryValue}" Maximum="100" Height="12" Foreground="#B8A5FA" Background="#30303D" BorderThickness="0" AutomationProperties.Name="Physical memory utilization"/><UniformGrid Columns="2" Margin="0,25,0,0"><StackPanel><TextBlock Text="AVAILABLE" Style="{StaticResource Label}"/><TextBlock Text="{Binding AvailableMemory}" FontSize="24" Foreground="{StaticResource AccentBrush}"/></StackPanel><StackPanel><TextBlock Text="TOTAL USABLE" Style="{StaticResource Label}"/><TextBlock Text="{Binding TotalMemory}" FontSize="24"/></StackPanel></UniformGrid></StackPanel></Border>
          <Border Style="{StaticResource Panel}" Margin="0,0,0,20"><StackPanel><TextBlock Text="Memory over this session" Style="{StaticResource SectionTitle}"/><charts:HistoryChart Values="{Binding MemoryHistory}" Stroke="#B8A5FA" Height="190" Margin="0,18,0,12"/><TextBlock Text="{Binding HistoryRange}" Style="{StaticResource Muted}" FontSize="11"/></StackPanel></Border>
          <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="What these numbers mean" Style="{StaticResource SectionTitle}"/><TextBlock Style="{StaticResource Muted}" LineHeight="23" Text="In use = total usable physical RAM minus available RAM. Windows includes reclaimable standby pages in available memory.&#10;&#10;Process memory is each process’s working set. Shared pages can appear in several processes, so adding the process column will not equal system memory in use. A large working set alone is not a memory leak.&#10;&#10;Available RAM is useful context, not a promise that an AI model or workload will fit. This version does not measure commit pressure or memory compression."/><Button Content="Find memory-heavy processes  →" Click="HighMemory_Click" HorizontalAlignment="Left" Margin="0,18,0,0"/></StackPanel></Border>
        </StackPanel>
      </ScrollViewer>

      <!-- HISTORY -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding PageIndex, Converter={StaticResource PageVisibility}, ConverterParameter=3}">
        <StackPanel Margin="0,0,8,0">
          <UniformGrid Columns="3" Margin="0,0,-16,20"><Border Style="{StaticResource Panel}" Margin="0,0,16,0"><StackPanel><TextBlock Text="AVERAGE CPU" Style="{StaticResource Label}"/><TextBlock Text="{Binding CpuAverage}" Style="{StaticResource Metric}" Foreground="{StaticResource AccentBrush}"/></StackPanel></Border><Border Style="{StaticResource Panel}" Margin="0,0,16,0"><StackPanel><TextBlock Text="PEAK CPU" Style="{StaticResource Label}"/><TextBlock Text="{Binding CpuPeak}" Style="{StaticResource Metric}"/></StackPanel></Border><Border Style="{StaticResource Panel}" Margin="0,0,16,0"><StackPanel><TextBlock Text="PEAK MEMORY" Style="{StaticResource Label}"/><TextBlock Text="{Binding MemoryPeak}" Style="{StaticResource Metric}" Foreground="#B8A5FA"/></StackPanel></Border></UniformGrid>
          <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="CPU + memory · 0–100%" Style="{StaticResource SectionTitle}"/><charts:HistoryChart Values="{Binding CpuHistory}" SecondaryValues="{Binding MemoryHistory}" Stroke="{StaticResource AccentBrush}" Height="300" Margin="0,18,0,18"/><TextBlock Text="{Binding HistoryRange}" Style="{StaticResource Muted}"/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><TextBlock Text="●  CPU" Foreground="{StaticResource AccentBrush}" Margin="0,0,24,0"/><TextBlock Text="●  Memory" Foreground="#B8A5FA"/></StackPanel></StackPanel></Border>
          <TextBlock Text="The last 120 samples stay in memory. Chart spacing is per sample; pauses and interval changes can make elapsed time uneven. Averages are per sample. Missing readings leave gaps. History clears when you quit." Style="{StaticResource Muted}" LineHeight="21" Margin="0,18,0,0"/>
        </StackPanel>
      </ScrollViewer>

      <!-- SETTINGS -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding PageIndex, Converter={StaticResource PageVisibility}, ConverterParameter=4}">
        <StackPanel Margin="0,0,8,0">
          <Border Style="{StaticResource Panel}" Margin="0,0,0,20"><StackPanel><TextBlock Text="Make yourself at home" Style="{StaticResource SectionTitle}"/><Grid Margin="0,18,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Refresh interval (seconds)"/><TextBlock Text="2 seconds is a good balance for everyday use." Style="{StaticResource Muted}" FontSize="11" Margin="0,6,20,0"/></StackPanel><ComboBox Grid.Column="1" ItemsSource="{Binding Intervals}" SelectedItem="{Binding Interval}" AutomationProperties.Name="Refresh interval in seconds"/></Grid><CheckBox Content="Keep ARMpulse above other windows" IsChecked="{Binding AlwaysOnTop}" Margin="0,0,0,14"/><TextBlock Text="Preferences are saved locally. Sampling slows to at least 5 seconds while minimized." Style="{StaticResource Muted}" FontSize="11"/></StackPanel></Border>
          <Border Style="{StaticResource Panel}" Margin="0,0,0,20"><StackPanel><TextBlock Text="Built for your Windows on ARM PC" Style="{StaticResource SectionTitle}"/><TextBlock Text="ARMpulse 0.1.0 · native WPF / .NET 10" Margin="0,8,0,8"/><TextBlock Text="{Binding Runtime}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding ArmCount}" Margin="0,20,0,6" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="{Binding EmulatedCount}" Style="{StaticResource Muted}"/><TextBlock Text="ARM64EC apps can mix native and emulated code and may be reported as x64 on ARM. Labels describe the Windows process machine type, not every module inside it." Style="{StaticResource Muted}" FontSize="11" LineHeight="19" Margin="0,12,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Honest numbers. No background surprises." Style="{StaticResource SectionTitle}"/><TextBlock Style="{StaticResource Muted}" LineHeight="23" Text="No accounts, analytics, remote uploads, drivers, startup entries, or background service. Closing the window quits the app. CSV exports happen only when you ask.&#10;&#10;CPU is normalized across all logical processors. I/O includes process file and device reads/writes; it is not a disk-only or per-process network counter. Restricted processes display unavailable values.&#10;&#10;This version does not expose GPU/NPU utilization, temperature, fan speed, or per-core load. Lower priority changes CPU scheduling to Below Normal; it is not EcoQoS or a power cap.&#10;&#10;Ctrl+F: find a process · Ctrl+Space: pause/resume · F5: refresh (when live)."/><TextBlock Text="Inspired by SiliconPulse. Independently implemented for Windows." Style="{StaticResource Muted}" FontSize="11" Margin="0,20,0,0"/></StackPanel></Border>
        </StackPanel>
      </ScrollViewer>
      <DockPanel Grid.Row="2" Margin="0,14,0,0"><TextBlock Text="{Binding LastUpdate}" DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="10"/><TextBlock Text="{Binding Message}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/></DockPanel>
    </Grid>
  </Grid>
</Window>
